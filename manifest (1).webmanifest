{
  "name": "Día a día · Evaluación por competencias",
  "short_name": "Día a día",
  "description": "Anota positivos, negativos y faltas en clase y envíalos a la app del ordenador.",
  "lang": "es",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f6f7",
  "theme_color": "#14b8b0",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "archivo",
          "accept": [
            "application/json",
            "application/octet-stream",
            "text/plain",
            ".json"
          ]
        }
      ]
    }
  }
}